// base identifiers
APP_ID_PREFIX               = app.monogatari
APP_ID_SUFFIX               = Monogatari

PRODUCT_BUNDLE_IDENTIFIER   = $(APP_ID_PREFIX).$(APP_ID_SUFFIX)

// ----- iCloud / CloudKit -----
ICLOUD_CONTAINER_ID         = iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
UBIQUITY_KVSTORE_ID         = $(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)

// Sideload build: the CANONICAL_BUILD flag stays undefined.
OTHER_SWIFT_FLAGS = $(inherited)

// Optional distributor-owned OAuth credentials. Supply values through private build settings.
BANGUMI_CLIENT_ID =
BANGUMI_CLIENT_SECRET =
SHIKIMORI_CLIENT_ID =
SHIKIMORI_CLIENT_SECRET =
#include? "Private.xcconfig"
